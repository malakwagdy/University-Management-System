<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox spacing="10">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Instructor Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="instructorNameLabel" text="Welcome, Instructor" />
            <Label fx:id="departmentLabel" text="Department: CS" />
            <Button fx:id="logoutBtn" text="Logout" />
         </HBox>
      </VBox>
   </top>
   
   <left>
      <VBox spacing="10" prefWidth="200.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="Navigation" />
         <Button fx:id="myCoursesBtn" text="My Courses" maxWidth="1.7976931348623157E308" />
         <Button fx:id="studentsBtn" text="My Students" maxWidth="1.7976931348623157E308" />
         <Button fx:id="assignmentsBtn" text="Assignments" maxWidth="1.7976931348623157E308" />
         <Button fx:id="quizzesBtn" text="Quizzes" maxWidth="1.7976931348623157E308" />
         <Button fx:id="officeHoursBtn" text="Office Hours" maxWidth="1.7976931348623157E308" />
         <Button fx:id="gradesBtn" text="Grade Management" maxWidth="1.7976931348623157E308" />
         <Region VBox.vgrow="ALWAYS" />
         <Separator />
         <Button fx:id="leaveRequestBtn" text="Leave Requests" maxWidth="1.7976931348623157E308" />
      </VBox>
   </left>
   
   <center>
      <ScrollPane fitToWidth="true">
         <VBox spacing="20">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- Quick Stats -->
            <HBox spacing="20">
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Total Courses" />
                  <Label fx:id="totalCoursesLabel" text="4" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Total Students" />
                  <Label fx:id="totalStudentsLabel" text="120" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Pending Grading" />
                  <Label fx:id="pendingGradingLabel" text="15" />
               </VBox>
            </HBox>
            
            <!-- My Courses Section -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="My Courses" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addCourseBtn" text="+ Add Course" />
               </HBox>
               <TableView fx:id="coursesTable" prefHeight="250.0">
                  <columns>
                     <TableColumn fx:id="courseIdCol" text="Course ID" prefWidth="120.0" />
                     <TableColumn fx:id="courseNameCol" text="Course Name" prefWidth="200.0" />
                     <TableColumn fx:id="studentsCountCol" text="Students" prefWidth="100.0" />
                     <TableColumn fx:id="assignmentsCountCol" text="Assignments" prefWidth="120.0" />
                     <TableColumn fx:id="actionsCol" text="Actions" prefWidth="200.0" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Recent Activity -->
            <VBox spacing="10">
               <Label text="Recent Activity" />
               <ListView fx:id="activityList" prefHeight="150.0" />
            </VBox>
            
            <!-- Office Hours -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="Office Hours" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="editOfficeHoursBtn" text="Edit Hours" />
               </HBox>
               <ListView fx:id="officeHoursList" prefHeight="100.0" />
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>

