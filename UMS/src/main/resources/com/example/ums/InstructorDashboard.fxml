<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.InstructorDashboardController">
   <top>
      <VBox spacing="10">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Instructor Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="instructorNameLabel" text="Welcome, Instructor" />
            <Label fx:id="departmentLabel" text="Department: CS" />
            <Button fx:id="logoutBtn" onAction="#handleLogoutButton" text="Logout" />
         </HBox>
      </VBox>
   </top>
   
   <left>
      <VBox prefWidth="200.0" spacing="10">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="Navigation" />
         <Button fx:id="myCoursesBtn" maxWidth="1.7976931348623157E308" text="My Courses" />
         <Button fx:id="studentsBtn" maxWidth="1.7976931348623157E308" text="My Students" />
         <Button fx:id="assignmentsBtn" maxWidth="1.7976931348623157E308" text="Assignments" />
         <Button fx:id="quizzesBtn" maxWidth="1.7976931348623157E308" text="Quizzes" />
         <Button fx:id="officeHoursBtn" maxWidth="1.7976931348623157E308" text="Office Hours" />
         <Button fx:id="gradesBtn" maxWidth="1.7976931348623157E308" text="Grade Management" />
         <Button fx:id="classroom_btn" mnemonicParsing="false" onAction="#viewClassrooms" prefHeight="26.0" prefWidth="172.0" text="Classrooms" />
         <Region VBox.vgrow="ALWAYS" />
         <Separator />
         <Button fx:id="leaveRequestBtn" maxWidth="1.7976931348623157E308" text="Leave Requests" />
      </VBox>
   </left>
   
   <center>
      <ScrollPane fitToWidth="true">
         <VBox spacing="20">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- Quick Stats -->
            <HBox spacing="20">
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Total Courses" />
                  <Label fx:id="totalCoursesLabel" text="4" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Total Students" />
                  <Label fx:id="totalStudentsLabel" text="120" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Pending Grading" />
                  <Label fx:id="pendingGradingLabel" text="15" />
               </VBox>
            </HBox>
            
            <!-- My Courses Section -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="My Courses" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addCourseBtn" text="+ Add Course" />
               </HBox>
               <TableView fx:id="coursesTable" prefHeight="250.0">
                  <columns>
                     <TableColumn fx:id="courseIdCol" prefWidth="120.0" text="Course ID" />
                     <TableColumn fx:id="courseNameCol" prefWidth="200.0" text="Course Name" />
                     <TableColumn fx:id="studentsCountCol" prefWidth="100.0" text="Students" />
                     <TableColumn fx:id="assignmentsCountCol" prefWidth="120.0" text="Assignments" />
                     <TableColumn fx:id="actionsCol" prefWidth="200.0" text="Actions" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Recent Activity -->
            <VBox spacing="10">
               <Label text="Recent Activity" />
               <ListView fx:id="activityList" prefHeight="150.0" />
            </VBox>
            
            <!-- Office Hours -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="Office Hours" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="editOfficeHoursBtn" text="Edit Hours" />
               </HBox>
               <ListView fx:id="officeHoursList" prefHeight="100.0" />
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>
