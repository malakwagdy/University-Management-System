<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="813.0" prefWidth="1326.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.DeptHeadDashboardController">
   <top>
      <VBox prefWidth="284.0" spacing="10">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Department Head Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="deptHeadNameLabel" text="Welcome, Department Head" />
            <Label fx:id="departmentNameLabel" text="Department: Computer Science" />
            <Button fx:id="logoutBtn" onAction="#handleLogoutButton" text="Logout" />
         </HBox>
      </VBox>
   </top>
   
   <left>
      <VBox prefWidth="220.0" spacing="10">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="Department Management" />
         <Button fx:id="instructorsBtn" maxWidth="1.7976931348623157E308" onAction="#handleHomepageButton" text="Instructors" />
         <Button fx:id="coursesBtn" maxWidth="1.7976931348623157E308" text="Department Courses" />
         <Button fx:id="studentsBtn" maxWidth="1.7976931348623157E308" text="Department Students" />
         <Separator />
         <Button fx:id="myCoursesBtn" maxWidth="1.7976931348623157E308" onAction="#hamdleMyCoursesButton" text="My Courses" />
         <Region VBox.vgrow="ALWAYS" />
      </VBox>
   </left>
   <center>
      <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <ScrollPane fx:id="homepageView" fitToWidth="true" prefHeight="355.0" prefWidth="479.0">
               <VBox spacing="20">
                  <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
                  
                  <!-- Department Overview Stats -->
                  <HBox spacing="20">
                     <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Department Instructors" />
                        <Label fx:id="instructorsCountLabel" text="25" />
                     </VBox>
                     <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Department Courses" />
                        <Label fx:id="coursesCountLabel" text="45" />
                     </VBox>
                     <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Department Students" />
                        <Label fx:id="studentsCountLabel" text="350" />
                     </VBox>
                     <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Pending Requests" />
                        <Label fx:id="pendingRequestsLabel" text="8" />
                     </VBox>
                  </HBox>
                  
                  <!-- Department Instructors -->
                  <VBox spacing="10">
                     <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Department Instructors" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="instructorRoleFilter" onAction="#handleInstructorRoleFilter" promptText="Filter by Role" />
                     </HBox>
                     <TableView fx:id="instructorsTable" prefHeight="250.0">
                        <columns>
                           <TableColumn fx:id="instructorIdCol" prefWidth="133.0" text="Instructor ID" />
                           <TableColumn fx:id="instructorNameCol" prefWidth="174.0" text="Name" />
                           <TableColumn fx:id="instructorEmailCol" prefWidth="236.0" text="Email" />
                           <TableColumn fx:id="instructorRoleCol" prefWidth="124.0" text="Role" />
                           <TableColumn fx:id="actionsCol" prefWidth="153.0" text="Actions" />
                        </columns>
                     </TableView>
                  </VBox>
                  
                  <!-- Department Courses -->
                  <VBox spacing="10">
                     <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Department Courses" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchByCourseIdField" onAction="#handleSearchByCourseIdField" promptText="Search" />
                        <Button fx:id="addCourseBtn" onAction="#handleAddCourseButton" text="+ Add Course" />
                     </HBox>
                     <TableView fx:id="coursesTable" prefHeight="200.0">
                        <columns>
                           <TableColumn fx:id="courseIdCol" prefWidth="83.0" text="Course ID" />
                           <TableColumn fx:id="courseNameCol" prefWidth="182.0" text="Course Name" />
                           <TableColumn fx:id="courseDescriptionCol" prefWidth="249.0" text="Course Description" />
                           <TableColumn fx:id="courseInstructorsCol" prefWidth="227.0" text="Course Instructors" />
                           <TableColumn fx:id="bylawCol" prefWidth="92.848388671875" text="Bylaw" />
                           <TableColumn fx:id="courseActionsCol" prefWidth="232.151611328125" text="Actions" />
                        </columns>
                     </TableView>
                  </VBox>
               </VBox>
            </ScrollPane>
            <ScrollPane fx:id="myCoursesView" fitToWidth="true" layoutX="10.0" layoutY="10.0" prefHeight="355.0" prefWidth="479.0" visible="false">
               <content>
                  <VBox spacing="20">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <HBox spacing="20">
                           <children>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Department Instructors" />
                                    <Label fx:id="instructorsCountLabel1" text="25" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Department Courses" />
                                    <Label fx:id="coursesCountLabel1" text="45" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Department Students" />
                                    <Label fx:id="studentsCountLabel1" text="350" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Pending Requests" />
                                    <Label fx:id="pendingRequestsLabel1" text="8" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="10">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10">
                                 <children>
                                    <Label text="My Courses" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="searchByCourseIdField1" onAction="#handleSearchByCourseIdField" promptText="Search" />
                                    <Button fx:id="addCourseBtn1" onAction="#handleAddCourseButton" text="+ Add Course" />
                                 </children>
                              </HBox>
                              <TableView fx:id="myCoursesTable" prefHeight="200.0">
                                 <columns>
                                    <TableColumn fx:id="myCourseIdCol" prefWidth="83.0" text="Course ID" />
                                    <TableColumn fx:id="myCourseNameCol" prefWidth="182.0" text="Course Name" />
                                    <TableColumn fx:id="myCourseDescriptionCol" prefWidth="249.0" text="Course Description" />
                                    <TableColumn fx:id="myCourseBylawCol" prefWidth="141.0" text="Bylaw" />
                                    <TableColumn fx:id="myCourseActionsCol" prefWidth="184.0" text="Actions" />
                                 </columns>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </StackPane>
   </center>
</BorderPane>
