<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="429.0" prefWidth="366.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.EditCourseController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <VBox fx:id="formBox" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label fx:id="titleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Course Details" />
            <Separator />
            <HBox spacing="10.0">
               <children>
                  <Label minWidth="100.0" text="Course ID:" />
                  <Label fx:id="courseIdLabel">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label minWidth="100.0" text="Course Name:" />
                  <Label fx:id="nameLabel">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin></Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label minWidth="100.0" text="Bylaw:" />
                  <Label fx:id="bylawLabel">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin></Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label minWidth="100.0" text="Course Description:" />
                  <Label fx:id="descriptionLabel" />
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label minWidth="100.0" text="Professor:" />
                  <Label fx:id="professorLabel" />
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label minWidth="100.0" text="Teaching Assistant (s):" />
                  <Label fx:id="taLabel" />
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label fx:id="materialsLabel" minWidth="100.0" text="Course Materials: " />
                  <Label fx:id="taLabel1" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Separator />
      <HBox spacing="10.0">
         <children>
            <Button fx:id="saveBtn" onAction="#handleSaveButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Save" />
            <Button fx:id="cancelBtn" onAction="#handleCancelButton" text="Cancel" />
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>
