<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox spacing="10">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Student Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="studentNameLabel" text="Welcome, Student" />
            <Button fx:id="logoutBtn" text="Logout" />
         </HBox>
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true">
         <VBox spacing="20">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- Quick Stats Section -->
            <HBox spacing="20">
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="GPA" />
                  <Label fx:id="gpaLabel" text="3.75" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Current Courses" />
                  <Label fx:id="coursesCountLabel" text="5" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Pending Assignments" />
                  <Label fx:id="pendingAssignmentsLabel" text="3" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Semester" />
                  <Label fx:id="semesterLabel" text="Fall 2024" />
               </VBox>
            </HBox>
            
            <!-- My Courses Section -->
            <VBox spacing="10">
               <Label text="My Courses" />
               <TableView fx:id="coursesTable" prefHeight="200.0">
                  <columns>
                     <TableColumn fx:id="courseIdCol" text="Course ID" prefWidth="120.0" />
                     <TableColumn fx:id="courseNameCol" text="Course Name" prefWidth="250.0" />
                     <TableColumn fx:id="instructorCol" text="Instructor" prefWidth="150.0" />
                     <TableColumn fx:id="gradeCol" text="Grade" prefWidth="100.0" />
                     <TableColumn fx:id="actionsCol" text="Actions" prefWidth="150.0" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Recent Assignments Section -->
            <VBox spacing="10">
               <Label text="Recent Assignments" />
               <TableView fx:id="assignmentsTable" prefHeight="200.0">
                  <columns>
                     <TableColumn fx:id="assignmentNameCol" text="Assignment" prefWidth="200.0" />
                     <TableColumn fx:id="courseCol" text="Course" prefWidth="150.0" />
                     <TableColumn fx:id="dueDateCol" text="Due Date" prefWidth="120.0" />
                     <TableColumn fx:id="statusCol" text="Status" prefWidth="100.0" />
                     <TableColumn fx:id="gradeCol2" text="Grade" prefWidth="100.0" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Upcoming Quizzes Section -->
            <VBox spacing="10">
               <Label text="Upcoming Quizzes" />
               <ListView fx:id="quizzesList" prefHeight="150.0" />
            </VBox>
            
            <!-- Action Buttons -->
            <HBox spacing="15" alignment="CENTER">
               <Button fx:id="viewAllCoursesBtn" text="View All Courses" />
               <Button fx:id="viewAssignmentsBtn" text="View All Assignments" />
               <Button fx:id="viewGradesBtn" text="View Grades" />
               <Button fx:id="viewScheduleBtn" text="View Schedule" />
            </HBox>
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>

