<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.AddClassroomController">
   <children>
      <Label layoutX="235.0" layoutY="59.0" text="Adding a new classroom" />
      <TextField fx:id="nhall_capacity" layoutX="301.0" layoutY="141.0" />
      <TextField fx:id="nhall_type" layoutX="301.0" layoutY="206.0" />
      <Label layoutX="160.0" layoutY="145.0" text="New Hall Capacity" />
      <Label layoutX="170.0" layoutY="210.0" text="New Hall Type" />
      <Button fx:id="AddClass" layoutX="320.0" layoutY="281.0" mnemonicParsing="false" onAction="#handleAddclassroomButton" text="Add" />
      <Button fx:id="backBtn" layoutX="249.0" layoutY="281.0" mnemonicParsing="false" onAction="#handleBackButton" text="Back" />
   </children>
</AnchorPane>
