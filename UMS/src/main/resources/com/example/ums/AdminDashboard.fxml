<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.AdminDashboardController">
   <top>
      <VBox spacing="10">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Admin Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="adminNameLabel" text="Welcome, Administrator" />
            <Button fx:id="logoutBtn" onAction="#handleLogoutButton" text="Logout" />
         </HBox>
      </VBox>
   </top>
   
   <left>
      <VBox prefWidth="220.0" spacing="10">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="System Management" />
         <Button fx:id="userManagementBtn" maxWidth="1.7976931348623157E308" onAction="#handleUserManagementBtn" text="User Management" />
         <Button fx:id="studentRecordsBtn" maxWidth="1.7976931348623157E308" onAction="#handleStudentRecordsButton" text="Student Records" />
         <Button fx:id="hallManagementBtn" mnemonicParsing="false" onAction="#handleHallManagementButton" prefHeight="26.0" prefWidth="189.0" text="Hall Management" />
         <Button fx:id="courseManagementBtn" maxWidth="1.7976931348623157E308" onAction="#handleCourseManagementButton" text="Course Management" />
         <Button fx:id="equipmentBtn" maxWidth="1.7976931348623157E308" text="Equipment" />
         <Button fx:id="softwareBtn" maxWidth="1.7976931348623157E308" text="Software" />
         <Region VBox.vgrow="ALWAYS" />
      </VBox>
   </left>
   <center>
      <StackPane prefHeight="813.0" prefWidth="1100.0" BorderPane.alignment="CENTER">
         <children>
            <ScrollPane fx:id="homePageView" fitToWidth="true">
               <VBox spacing="20">
                  <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
                  
                              <!-- System Overview Stats -->
                  <HBox spacing="20">
                     <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Total Students" />
                        <Label fx:id="totalStudentsLabel" text="1,250" />
                     </VBox>
                     <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Total Instructors" />
                        <Label fx:id="totalInstructorsLabel" text="85" />
                     </VBox>
                     <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Active Courses" />
                        <Label fx:id="activeCoursesLabel" text="150" />
                     </VBox>
                     <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Pending Issues" />
                        <Label fx:id="pendingIssuesLabel" text="12" />
                     </VBox>
                  </HBox>
                  
                              <!-- User Management Section -->
                  <VBox spacing="10">
                     <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="User Management" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="userTypeFilter" onAction="#handleUserTypeFilter" promptText="Filter by Type" />
                        <Button fx:id="addUserBtn" onAction="#handleAddUserButton" text="+ Add User" />
                     </HBox>
                     <TableView fx:id="usersTable" prefHeight="300.0">
                        <columns>
                           <TableColumn fx:id="userIdCol" prefWidth="150.0" text="User Id" />
                           <TableColumn fx:id="userNameCol" prefWidth="200.0" text="Name" />
                           <TableColumn fx:id="userEmailCol" prefWidth="200.0" text="Email" />
                           <TableColumn fx:id="userTypeCol" prefWidth="120.0" text="Type" />
                           <TableColumn fx:id="actionsCol" prefWidth="200.0" text="Actions" />
                        </columns>
                     </TableView>
                  </VBox>
                  <VBox fx:id="homePageLayout" spacing="10">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                           <children>
                              <Label text="Admission Requests" />
                              <Region HBox.hgrow="ALWAYS" />
                              <ComboBox fx:id="admissionStatusFilter" onAction="#handleStatusFilter" promptText="Filter by Status" />
                           </children>
                        </HBox>
                        <TableView fx:id="admissionsTable" prefHeight="300.0">
                           <columns>
                              <TableColumn fx:id="applicantIdCol" prefWidth="103.32467651367188" text="Application ID" />
                              <TableColumn fx:id="applicantNameCo" prefWidth="246.67532348632812" text="Name" />
                              <TableColumn fx:id="applicantEmailCol" prefWidth="200.0" text="Email" />
                              <TableColumn fx:id="applicantPhoneNoCol" prefWidth="120.0" text="Phone Number" />
                              <TableColumn fx:id="applicantStatusCol" prefWidth="100.0" text="Status" />
                              <TableColumn fx:id="actionsCol1" prefWidth="200.0" text="Actions" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </VBox>
            </ScrollPane>
            <ScrollPane fx:id="hallManagementView" fitToWidth="true" layoutX="10.0" layoutY="10.0" visible="false">
               <content>
                  <VBox spacing="20">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <HBox spacing="20">
                           <children>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Total Students" />
                                    <Label fx:id="totalStudentsLabel1" text="1,250" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Total Instructors" />
                                    <Label fx:id="totalInstructorsLabel1" text="85" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Active Courses" />
                                    <Label fx:id="activeCoursesLabel1" text="150" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Pending Issues" />
                                    <Label fx:id="pendingIssuesLabel1" text="12" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="10">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10">
                                 <children>
                                    <Label text="Hall Management" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="addClassroomBtn" mnemonicParsing="false" onAction="#handleAddClassroomButton" text="+ Add Classroom" />
                                 </children>
                              </HBox>
                              <TableView fx:id="hallsTable" prefHeight="300.0">
                                 <columns>
                                    <TableColumn fx:id="hallIdCol" prefWidth="150.0" text="Hall ID" />
                                    <TableColumn fx:id="capacityCol" prefWidth="200.0" text="Student Capacity" />
                                    <TableColumn fx:id="hallTypeCol" prefWidth="200.0" text="Hall Type" />
                                    <TableColumn fx:id="maintenanceCol" prefWidth="120.0" text="Maintenance" />
                                    <TableColumn fx:id="availabilityCol" prefWidth="120.0" text="Availability" />
                                    <TableColumn fx:id="hallsActionsCol" prefWidth="200.0" text="Actions" />
                                 </columns>
                                 <placeholder>
                                    <Label fx:id="hallsPlaceholder" text="No Records Found" />
                                 </placeholder>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            <ScrollPane fx:id="studentRecordsView" fitToWidth="true" layoutX="10.0" layoutY="10.0" visible="false">
               <content>
                  <VBox spacing="20">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <HBox spacing="20">
                           <children>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Total Students" />
                                    <Label fx:id="totalStudentsLabel11" text="1,250" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Total Instructors" />
                                    <Label fx:id="totalInstructorsLabel11" text="85" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Active Courses" />
                                    <Label fx:id="activeCoursesLabel11" text="150" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Pending Issues" />
                                    <Label fx:id="pendingIssuesLabel11" text="12" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="10">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10">
                                 <children>
                                    <Label text="Student Records" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="searchByIdField" onAction="#handleSearchByIdField" promptText="Search" />
                                 </children>
                              </HBox>
                              <TableView fx:id="studentRecordsTable" prefHeight="300.0">
                                 <columns>
                                    <TableColumn fx:id="studentIdCol" prefWidth="150.0" text="Student ID" />
                                    <TableColumn fx:id="studentNameCol" prefWidth="200.0" text="Name" />
                                    <TableColumn fx:id="studentEmailCol" prefWidth="200.0" text="Email" />
                                    <TableColumn fx:id="studentGPACol" prefWidth="120.0" text="Cumulative GPA" />
                                    <TableColumn fx:id="recordsActionsCol" prefWidth="200.0" text="Actions" />
                                 </columns>
                                 <placeholder>
                                    <Label fx:id="studentPlaceholder" text="No Records Found" />
                                 </placeholder>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            <ScrollPane fx:id="courseManagementView" fitToWidth="true" layoutX="10.0" layoutY="10.0" visible="false">
               <content>
                  <VBox spacing="20">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <HBox spacing="20">
                           <children>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Total Students" />
                                    <Label fx:id="totalStudentsLabel111" text="1,250" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Total Instructors" />
                                    <Label fx:id="totalInstructorsLabel111" text="85" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Active Courses" />
                                    <Label fx:id="activeCoursesLabel111" text="150" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                                 <children>
                                    <Label text="Pending Issues" />
                                    <Label fx:id="pendingIssuesLabel111" text="12" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="10">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10">
                                 <children>
                                    <Label text="Course Management" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="searchByCourseIdField" onAction="#handleSearchByCourseIdField" promptText="Search" />
                                    <Button fx:id="addCourseBtn" mnemonicParsing="false" onAction="#handleAddCourseButton" text="+ Add Courses" />
                                 </children>
                              </HBox>
                              <TableView fx:id="courseManagementTable" prefHeight="300.0">
                                 <columns>
                                    <TableColumn fx:id="courseIdCol" prefWidth="150.0" text="Course ID" />
                                    <TableColumn fx:id="courseNameCol" prefWidth="200.0" text="Course Name" />
                                    <TableColumn fx:id="courseDescriptionCol" prefWidth="200.0" text="Course Description" />
                                    <TableColumn fx:id="courseActionsCol" prefWidth="200.0" text="Actions" />
                                 </columns>
                                 <placeholder>
                                    <Label fx:id="coursePlaceholder" text="No Records Found" />
                                 </placeholder>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </StackPane>
   </center>
</BorderPane>
