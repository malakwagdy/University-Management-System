<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.AdminDashboardController">
   <top>
      <VBox spacing="10">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Admin Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="adminNameLabel" text="Welcome, Administrator" />
            <Button fx:id="logoutBtn" onAction="#handleLogoutButton" text="Logout" />
         </HBox>
      </VBox>
   </top>
   
   <left>
      <VBox prefWidth="220.0" spacing="10">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="System Management" />
         <Button fx:id="userManagementBtn" maxWidth="1.7976931348623157E308" text="User Management" />
         <Button fx:id="studentsBtn" maxWidth="1.7976931348623157E308" text="Students" />
         <Button fx:id="instructorsBtn" maxWidth="1.7976931348623157E308" text="Instructors" />
         <Button fx:id="hrBtn" maxWidth="1.7976931348623157E308" text="HR Staff" />
         <Button fx:id="parentsBtn" maxWidth="1.7976931348623157E308" text="Parents" />
         <Separator />
         <Button fx:id="coursesBtn" maxWidth="1.7976931348623157E308" text="Course Management" />
         <Button fx:id="equipmentBtn" maxWidth="1.7976931348623157E308" text="Equipment" />
         <Button fx:id="hallsBtn" maxWidth="1.7976931348623157E308" text="Halls &amp; Rooms" />
         <Button fx:id="softwareBtn" maxWidth="1.7976931348623157E308" text="Software" />
         <Separator />
         <Button fx:id="reportsBtn" maxWidth="1.7976931348623157E308" text="Reports &amp; Analytics" />
         <Button fx:id="settingsBtn" maxWidth="1.7976931348623157E308" text="System Settings" />
         <Region VBox.vgrow="ALWAYS" />
      </VBox>
   </left>
   
   <center>
      <ScrollPane fitToWidth="true">
         <VBox spacing="20">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- System Overview Stats -->
            <HBox spacing="20">
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Total Students" />
                  <Label fx:id="totalStudentsLabel" text="1,250" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Total Instructors" />
                  <Label fx:id="totalInstructorsLabel" text="85" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Active Courses" />
                  <Label fx:id="activeCoursesLabel" text="150" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Pending Issues" />
                  <Label fx:id="pendingIssuesLabel" text="12" />
               </VBox>
            </HBox>
            
            <!-- User Management Section -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="User Management" />
                  <Region HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="userTypeFilter" promptText="Filter by Type" />
                  <Button fx:id="addUserBtn" text="+ Add User" />
               </HBox>
               <TableView fx:id="usersTable" prefHeight="300.0">
                  <columns>
                     <TableColumn fx:id="usernameCol" prefWidth="150.0" text="Username" />
                     <TableColumn fx:id="nameCol" prefWidth="200.0" text="Name" />
                     <TableColumn fx:id="emailCol" prefWidth="200.0" text="Email" />
                     <TableColumn fx:id="typeCol" prefWidth="120.0" text="Type" />
                     <TableColumn fx:id="statusCol" prefWidth="100.0" text="Status" />
                     <TableColumn fx:id="actionsCol" prefWidth="200.0" text="Actions" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Recent System Activity -->
            <VBox spacing="10">
               <Label text="Recent System Activity" />
               <ListView fx:id="activityList" prefHeight="150.0" />
            </VBox>
            
            <!-- Quick Actions -->
            <VBox spacing="10">
               <Label text="Quick Actions" />
               <HBox spacing="15">
                  <Button fx:id="generateReportBtn" text="Generate Report" />
                  <Button fx:id="backupSystemBtn" text="Backup System" />
                  <Button fx:id="viewIssuesBtn" text="View Issues" />
                  <Button fx:id="systemLogsBtn" text="System Logs" />
               </HBox>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>
