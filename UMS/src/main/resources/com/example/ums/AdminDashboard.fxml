<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox spacing="10">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Admin Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="adminNameLabel" text="Welcome, Administrator" />
            <Button fx:id="logoutBtn" text="Logout" />
         </HBox>
      </VBox>
   </top>
   
   <left>
      <VBox spacing="10" prefWidth="220.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="System Management" />
         <Button fx:id="userManagementBtn" text="User Management" maxWidth="1.7976931348623157E308" />
         <Button fx:id="studentsBtn" text="Students" maxWidth="1.7976931348623157E308" />
         <Button fx:id="instructorsBtn" text="Instructors" maxWidth="1.7976931348623157E308" />
         <Button fx:id="hrBtn" text="HR Staff" maxWidth="1.7976931348623157E308" />
         <Button fx:id="parentsBtn" text="Parents" maxWidth="1.7976931348623157E308" />
         <Separator />
         <Button fx:id="coursesBtn" text="Course Management" maxWidth="1.7976931348623157E308" />
         <Button fx:id="equipmentBtn" text="Equipment" maxWidth="1.7976931348623157E308" />
         <Button fx:id="hallsBtn" text="Halls &amp; Rooms" maxWidth="1.7976931348623157E308" />
         <Button fx:id="softwareBtn" text="Software" maxWidth="1.7976931348623157E308" />
         <Separator />
         <Button fx:id="reportsBtn" text="Reports &amp; Analytics" maxWidth="1.7976931348623157E308" />
         <Button fx:id="settingsBtn" text="System Settings" maxWidth="1.7976931348623157E308" />
         <Region VBox.vgrow="ALWAYS" />
      </VBox>
   </left>
   
   <center>
      <ScrollPane fitToWidth="true">
         <VBox spacing="20">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- System Overview Stats -->
            <HBox spacing="20">
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Total Students" />
                  <Label fx:id="totalStudentsLabel" text="1,250" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Total Instructors" />
                  <Label fx:id="totalInstructorsLabel" text="85" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Active Courses" />
                  <Label fx:id="activeCoursesLabel" text="150" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Pending Issues" />
                  <Label fx:id="pendingIssuesLabel" text="12" />
               </VBox>
            </HBox>
            
            <!-- User Management Section -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="User Management" />
                  <Region HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="userTypeFilter" promptText="Filter by Type" />
                  <Button fx:id="addUserBtn" text="+ Add User" />
               </HBox>
               <TableView fx:id="usersTable" prefHeight="300.0">
                  <columns>
                     <TableColumn fx:id="usernameCol" text="Username" prefWidth="150.0" />
                     <TableColumn fx:id="nameCol" text="Name" prefWidth="200.0" />
                     <TableColumn fx:id="emailCol" text="Email" prefWidth="200.0" />
                     <TableColumn fx:id="typeCol" text="Type" prefWidth="120.0" />
                     <TableColumn fx:id="statusCol" text="Status" prefWidth="100.0" />
                     <TableColumn fx:id="actionsCol" text="Actions" prefWidth="200.0" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Recent System Activity -->
            <VBox spacing="10">
               <Label text="Recent System Activity" />
               <ListView fx:id="activityList" prefHeight="150.0" />
            </VBox>
            
            <!-- Quick Actions -->
            <VBox spacing="10">
               <Label text="Quick Actions" />
               <HBox spacing="15">
                  <Button fx:id="generateReportBtn" text="Generate Report" />
                  <Button fx:id="backupSystemBtn" text="Backup System" />
                  <Button fx:id="viewIssuesBtn" text="View Issues" />
                  <Button fx:id="systemLogsBtn" text="System Logs" />
               </HBox>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>
