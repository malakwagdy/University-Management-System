<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="272.0" prefWidth="420.0" spacing="8.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.AddAssignmentController">
   <children>
      <HBox alignment="CENTER" spacing="5.0">
         <children>
            <Label prefWidth="50.0" text="Name:" />
            <TextField fx:id="assignmentNameField" prefWidth="200.0" promptText="Enter assignment name" />
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="51.0" prefWidth="400.0">
         <children>
            <Label text="Deadline:">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Label>
            <DatePicker fx:id="deadlineDatePicker" onAction="#handleDatePicker" promptText="Assignment deadline">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </DatePicker>
         </children>
      </HBox>
      <HBox alignment="CENTER" spacing="5.0">
         <children>
            <Label prefWidth="50.0" text="File:" />
            <TextField fx:id="materialFileField" editable="false" prefWidth="200.0" promptText="No file selected" />
            <Button fx:id="browseAssignBtn" mnemonicParsing="false" onAction="#handleBrowseAssign" text="Browse" />
         </children>
         <padding>
            <Insets left="65.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER" prefHeight="37.0" prefWidth="400.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancelButton" text="Cancel" />
            <Button mnemonicParsing="false" onAction="#handleSaveButton" text="Save" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
