<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox spacing="10">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Parent Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="parentNameLabel" text="Welcome, Parent" />
            <Button fx:id="logoutBtn" text="Logout" />
         </HBox>
      </VBox>
   </top>
   
   <left>
      <VBox spacing="10" prefWidth="200.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="My Children" />
         <ListView fx:id="childrenList" prefHeight="400.0" />
      </VBox>
   </left>
   
   <center>
      <ScrollPane fitToWidth="true">
         <VBox spacing="20">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- Selected Child Info -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label fx:id="selectedChildLabel" text="Select a child to view details" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="relationLabel" text="Relation: " />
               </HBox>
            </VBox>
            
            <!-- Child Overview Stats -->
            <HBox spacing="20">
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="GPA" />
                  <Label fx:id="childGpaLabel" text="--" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Current Courses" />
                  <Label fx:id="childCoursesCountLabel" text="--" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Semester" />
                  <Label fx:id="childSemesterLabel" text="--" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Major" />
                  <Label fx:id="childMajorLabel" text="--" />
               </VBox>
            </HBox>
            
            <!-- Child's Courses -->
            <VBox spacing="10">
               <Label text="Courses" />
               <TableView fx:id="childCoursesTable" prefHeight="200.0">
                  <columns>
                     <TableColumn fx:id="courseIdCol" text="Course ID" prefWidth="120.0" />
                     <TableColumn fx:id="courseNameCol" text="Course Name" prefWidth="250.0" />
                     <TableColumn fx:id="instructorCol" text="Instructor" prefWidth="150.0" />
                     <TableColumn fx:id="gradeCol" text="Grade" prefWidth="100.0" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Child's Grades -->
            <VBox spacing="10">
               <Label text="Recent Grades" />
               <TableView fx:id="gradesTable" prefHeight="200.0">
                  <columns>
                     <TableColumn fx:id="assignmentNameCol" text="Assignment/Quiz" prefWidth="200.0" />
                     <TableColumn fx:id="courseCol" text="Course" prefWidth="150.0" />
                     <TableColumn fx:id="gradeCol2" text="Grade" prefWidth="100.0" />
                     <TableColumn fx:id="dateCol" text="Date" prefWidth="120.0" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Action Buttons -->
            <HBox spacing="15" alignment="CENTER">
               <Button fx:id="viewFullTranscriptBtn" text="View Full Transcript" />
               <Button fx:id="viewAttendanceBtn" text="View Attendance" />
               <Button fx:id="contactInstructorBtn" text="Contact Instructor" />
            </HBox>
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>

