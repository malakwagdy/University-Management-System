<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.ViewTranscriptPopupController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Student Transcript" />
      <Separator />
      <HBox spacing="10.0">
         <children>
            <Label minWidth="100.0" text="Student ID:" />
            <Label fx:id="studentIdLabel" />
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <Label minWidth="100.0" text="Student Name:" />
            <Label fx:id="studentNameLabel" />
         </children>
      </HBox>
      <HBox layoutX="30.0" layoutY="118.0" spacing="10.0">
         <children>
            <Label minWidth="100.0" text="Cumulative GPA:" />
            <Label fx:id="studentGpaLabel" />
         </children>
      </HBox>
      <Separator />
      <Label style="-fx-font-weight: bold;" text="Courses" />
      <ScrollPane fitToWidth="true" prefHeight="300.0">
         <content>
            <TableView fx:id="coursesTable" prefHeight="280.0">
               <columns>
                  <TableColumn fx:id="courseIdCol" prefWidth="100.0" text="Course ID" />
                  <TableColumn fx:id="courseNameCol" prefWidth="200.0" text="Course Name" />
                  <TableColumn fx:id="gradeCol" prefWidth="100.0" text="Grade" />
               </columns>
            </TableView>
         </content>
      </ScrollPane>
      <HBox alignment="CENTER" prefHeight="42.0" prefWidth="404.0">
         <children>
            <Button fx:id="downloadBtn" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleDownloadButton" text="Download" />
         </children>
      </HBox>
   </children>
</VBox>
