<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.ViewUserPopupController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <VBox fx:id="detailsBox" spacing="8.0" VBox.vgrow="ALWAYS">
         <children>
            <Label fx:id="titleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="User Details" />
            <Separator />
         </children>
      </VBox>
      <Separator />
      <HBox spacing="10.0">
         <children>
            <Button fx:id="editBtn" onAction="#handleEditButton" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Edit" />
            <Button fx:id="deleteBtn" onAction="#handleDeleteButton" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Delete" />
            <Button fx:id="closeBtn" onAction="#handleCloseButton" text="Close" />
         </children>
      </HBox>
   </children>
</VBox>

