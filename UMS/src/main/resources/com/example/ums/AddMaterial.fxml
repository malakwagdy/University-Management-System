<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="272.0" prefWidth="420.0" spacing="8.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.AddMaterialController">
   <children>
      <HBox alignment="CENTER" spacing="5.0">
         <children>
            <Label prefWidth="50.0" text="Name:" />
            <TextField fx:id="materialNameField" prefWidth="200.0" promptText="Enter material name" />
         </children>
      </HBox>
      <HBox alignment="CENTER" spacing="5.0">
         <children>
            <Label prefWidth="50.0" text="File:" />
            <TextField fx:id="materialFileField" editable="false" prefWidth="200.0" promptText="No file selected" />
            <Button fx:id="browseMaterialBtn" mnemonicParsing="false" onAction="#handleBrowseMaterial" text="Browse" />
         </children>
         <padding>
            <Insets left="65.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER">
         <children>
            <Button fx:id="addMaterialBtn" mnemonicParsing="false" onAction="#handleAddMaterial" prefWidth="100.0" text="Add Material" />
         </children>
      </HBox>
      <ListView fx:id="materialsListView" prefHeight="80.0" prefWidth="400.0" />
      <HBox alignment="CENTER" prefHeight="37.0" prefWidth="400.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancelButton" text="Cancel" />
            <Button mnemonicParsing="false" onAction="#handleSaveButton" text="Save" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
