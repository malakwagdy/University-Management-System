<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ums.HrDashboardController">
   <top>
      <VBox spacing="10">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="HR Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="hrNameLabel" text="Welcome, HR Specialist" />
            <Label fx:id="departmentLabel" text="Department: HR" />
            <Button fx:id="logoutBtn" onAction="#handleLogoutButton" text="Logout" />
         </HBox>
      </VBox>
   </top>

   <left>
      <VBox prefWidth="220.0" spacing="10">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="HR Tools" />
         <Button fx:id="staffDirectoryBtn" maxWidth="1.7976931348623157E308" text="Staff Directory" />
         <Button fx:id="leaveRequestsBtn" maxWidth="1.7976931348623157E308" text="Leave Requests" />
         <Button fx:id="benefitsBtn" maxWidth="1.7976931348623157E308" text="Benefits" />
         <Button fx:id="equipmentBtn" maxWidth="1.7976931348623157E308" text="Equipment" />
         <Region VBox.vgrow="ALWAYS" />
      </VBox>
   </left>

   <center>
      <ScrollPane fitToWidth="true">
         <VBox spacing="20">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- HR Overview -->
            <HBox spacing="20">
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Employees" />
                  <Label fx:id="totalEmployeesLabel" text="240" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Training Sessions" />
                  <Label fx:id="trainingSessionsLabel" text="12" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Pending Leave Requests" />
                  <Label fx:id="pendingLeaveLabel" text="4" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Payroll Updates" />
                  <Label fx:id="payrollUpdatesLabel" text="5" />
               </VBox>
               <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <Label text="Benefits Reviews" />
                  <Label fx:id="benefitsReviewsLabel" text="7" />
               </VBox>
            </HBox>

            <!-- Professional Development -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="Department Employees" />
                  <Region HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="employeeRoleFilter" onAction="#handleEmployeeRoleFilter" promptText="Filter by Role" />
               </HBox>
               <TableView fx:id="employeeTable" prefHeight="220.0">
                  <columns>
                     <TableColumn fx:id="employeeIdCol" prefWidth="108.0" text="EmployeeID" />
                     <TableColumn fx:id="nameCol" prefWidth="183.0" text="Name" />
                     <TableColumn fx:id="emailCol" prefWidth="276.0" text="Email" />
                     <TableColumn fx:id="roleCol" prefWidth="128.0" text="Role" />
                     <TableColumn fx:id="salaryCol" prefWidth="114.0" text="Salary" />
                     <TableColumn fx:id="actionsCol" prefWidth="182.0" text="Actions" />
                  </columns>
               </TableView>
            </VBox>

            <!-- Payroll Information -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="Payroll Management" />
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="payrollSearchField" promptText="Search employees" />
                  <Button fx:id="exportPayrollBtn" text="Export Payroll" />
               </HBox>
               <TableView fx:id="payrollTable" prefHeight="220.0">
                  <columns>
                     <TableColumn fx:id="payrollEmployeeCol" prefWidth="180.0" text="Employee" />
                     <TableColumn fx:id="payrollRoleCol" prefWidth="150.0" text="Role" />
                     <TableColumn fx:id="payrollSalaryCol" prefWidth="120.0" text="Salary" />
                     <TableColumn fx:id="benefitsCostCol" prefWidth="120.0" text="Benefits" />
                     <TableColumn fx:id="payrollStatusCol" prefWidth="120.0" text="Status" />
                     <TableColumn fx:id="payrollUpdatedCol" prefWidth="150.0" text="Last Updated" />
                     <TableColumn fx:id="payrollActionsCol" prefWidth="150.0" text="Actions" />
                  </columns>
               </TableView>
            </VBox>

            <!-- Leave Requests -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="Leave Requests" />
                  <Region HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="leaveFilter" promptText="Filter" />
               </HBox>
               <TableView fx:id="leaveRequestsTable" prefHeight="200.0">
                  <columns>
                     <TableColumn fx:id="leaveEmployeeCol" prefWidth="150.0" text="Employee" />
                     <TableColumn fx:id="leaveTypeCol" prefWidth="120.0" text="Type" />
                     <TableColumn fx:id="leaveStartCol" prefWidth="120.0" text="Start" />
                     <TableColumn fx:id="leaveEndCol" prefWidth="120.0" text="End" />
                     <TableColumn fx:id="leaveStatusCol" prefWidth="100.0" text="Status" />
                     <TableColumn fx:id="leaveActionsCol" prefWidth="150.0" text="Actions" />
                  </columns>
               </TableView>
            </VBox>

            <!-- Benefits Management -->
            <VBox spacing="10">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label text="Benefits Management" />
                  <Region HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="benefitsFilter" promptText="Filter" />
                  <Button fx:id="updateBenefitsBtn" text="Update Package" />
               </HBox>
               <TableView fx:id="benefitsTable" prefHeight="200.0">
                  <columns>
                     <TableColumn fx:id="benefitsEmployeeCol" prefWidth="180.0" text="Employee" />
                     <TableColumn fx:id="benefitsPlanCol" prefWidth="180.0" text="Plan" />
                     <TableColumn fx:id="benefitsCoverageCol" prefWidth="150.0" text="Coverage" />
                     <TableColumn fx:id="benefitsStatusCol" prefWidth="120.0" text="Status" />
                     <TableColumn fx:id="benefitsUpdatedCol" prefWidth="150.0" text="Last Updated" />
                     <TableColumn fx:id="benefitsActionsCol" prefWidth="150.0" text="Actions" />
                  </columns>
               </TableView>
            </VBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="15">
               <Button fx:id="generateTrainingReportBtn" text="Training Report" />
               <Button fx:id="payrollReportBtn" text="Payroll Report" />
               <Button fx:id="benefitsReportBtn" text="Benefits Report" />
               <Button fx:id="contactDeptBtn" text="Contact Department Head" />
            </HBox>
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>
