               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </TextField>
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="41.0" prefWidth="600.0">
         <children>
            <Label alignment="CENTER" text="Phone Number:   " />
